    {
      "evidence_id": "E-TWIN",
      "source_id": "ISUOG-Practice-Guidelines-role-of-ultrasound-in-twin-pregnancy",
      "source_family_id": "10.1002/uog.29166",
      "version_chain_id": null,
      "document_version": "2025",
      "doi": "10.1002/uog.29166",
      "input_file": "benchmark/data/corpus/input/ISUOG-Practice-Guidelines-role-of-ultrasound-in-twin-pregnancy--47b3784a3f04.txt",
      "pdf_sha256": "47b3784a3f04344f7d8b59c317c0768dcff8189b20db797c510b6b43013a720d",
      "input_text_sha256": "60cbb1d9c69e05ff4d483db2b11f96978dc5a5cc88cbcb305bb2dae4afdad913",
      "coordinate_system": "raw_corpus_text_unicode_codepoints_half_open",
      "page_start": 4,
      "page_end": 4,
      "char_start": 17775,
      "char_end": 18368,
      "excerpt": "Women with an uncomplicated dichorionic twin\npregnancy should have a ﬁrst-trimester scan, a second-\ntrimester anomaly scan and scans every 4 weeks\nthereafter. Complicated dichorionic twins should be\nscanned more frequently, depending on the condition\nand its severity ( GOOD PRACTICE POINT ).\n• Uncomplicated monochorionic twins should have a\nﬁrst-trimester scan and be scanned every 2 weeks after\n16 weeks, in order to detect TTTS in a timely manner.\nComplicated monochorionic twins should be scanned\nmore frequently, depending on the condition and its\nseverity (GRADE OF RECOMMENDATION: C ).",
      "excerpt_sha256": "5bcf5c46c082430612750aeebb192a4cee5da57a5ab4dc06bf965b63a72f18e3",
      "proposed_role": "conditional_monitoring_branches",
      "locator_status": "text_verified_anchor_mapped_pdf_layout_review_pending",
      "clinical_review_status": "pending",
      "evidence_store_anchor_id": "224",
